# Copy to `.env` (git-ignored) and fill in. Never commit real values.

# --- Database (Supabase Postgres) ---
# Supabase dashboard -> Connect -> "Transaction pooler" (port 6543). Works on IPv4 networks and scales
# to many clients. The app disables prepared statements and requires SSL in code, so no URL params needed.
# URL-encode any special characters in the password (e.g. @ -> %40, # -> %23).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres

# --- API ---
PORT=4000
